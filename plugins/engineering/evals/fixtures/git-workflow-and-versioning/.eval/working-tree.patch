@@ -1,3 +1,6 @@
-export function paymentRetryTimeout(attempt: number): number {
-  return Math.min(1_000 * 2 ** attempt, 60_000);
+export function paymentRetryTimeout(
+  attempt: number,
+  remainingBudgetMs = 60_000,
+): number {
+  return Math.min(1_000 * 2 ** attempt, 60_000, Math.max(0, remainingBudgetMs));
 }
